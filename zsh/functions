# create folder and switch into it
function take {
  mkdir $1
  cd $1
}

function jump {
  cd ~/work/code/$1
}

# cd using interactive fzf
function cdfz {
   cd $(fd --type directory | fzf)
}

function fuck_mysql2 {
  gem install mysql2 -v "$1" -- --with-opt-dir=$(brew --prefix openssl) --with-ldflags=-L$(brew --prefix zstd)/lib --with-cflags="-Wno-error=implicit-function-declaration"
}

function fuck_bson_ext {
  gem install bson_ext -v "$1" -- --with-cflags="-Wno-error=implicit-function-declaration"
}

function fuck_pg {
  gem install pg -v "$1" -- --with-pg-config=$(brew --prefix postgresql@17)/bin/pg_config
}
